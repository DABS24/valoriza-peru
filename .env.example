# ValorizaPeru · ejemplo de variables de entorno
# Copiar a .env.local para desarrollo. NUNCA commitear .env.local.
#
# El nombre de la marca NO se configura por entorno: sale de `BRAND` en
# lib/constants.ts. Renombrar el portal = tocar esa constante.

# ────── App ──────
# URL base para los enlaces de los correos y los redirects de auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────── Supabase ──────
# Hoy comparte proyecto con el otro producto de la SAC; las tablas de este portal
# (portal_*, portal_miembros) tienen auth, RLS y bucket propios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SEGURIDAD: la service_role SALTA la RLS. Va SOLO acá (server) y JAMÁS
# en un NEXT_PUBLIC_*, ni en el browser, ni en un componente client.
# Única lectura permitida: lib/supabase/admin.ts (con import "server-only").
SUPABASE_SERVICE_ROLE_KEY=

# ────── Email transaccional (Resend) ──────
RESEND_API_KEY=
# Remitente de los correos. Debe ser un dominio verificado en Resend; si no, los
# correos rebotan y se quema la reputación del dominio.
RESEND_FROM_EMAIL=
# Remitente propio del portal. Acepta "correo@dominio" (el nombre visible lo pone
# la marca) o "Nombre <correo@dominio>" ya armado.
# ⚠️ PENDIENTE: mientras esté vacío, el nombre visible ya es la marca pero el
# dominio sigue siendo el heredado de la cuenta de Resend. Verificar dominio propio.
RESEND_FROM_PORTAL=
# A dónde contesta quien responde el correo.
RESEND_REPLY_TO=
# Remitente que usa la edge function de notificaciones.
EMAIL_FROM=

# ────── Scripts de mantenimiento (solo local, NO van al hosting) ──────
# Contraseña de las cuentas demo. NO se versiona: definirla local.
# La usan scripts/seed-portales.mjs y scripts/limpiar-portales.mjs.
PORTALES_DEMO_PASSWORD=
